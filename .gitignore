node_modules/
frontend/node_modules/
dist/
frontend/dist/
.vite/

# Forensic Uploads & Generated Reports (preserve folder structure, ignore generated assets)
backend/uploads/*
!backend/uploads/.gitkeep
backend/reports_generated/*
!backend/reports_generated/.gitkeep
backend/test_data/*
!backend/test_data/.gitkeep
backend/local_investigations.json

