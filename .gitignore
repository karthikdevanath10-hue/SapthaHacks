# Secrets & Environment variables (NEVER COMMIT SENSITIVE API KEYS)
.env
*.env
backend/.env
frontend/.env
.env.local
.env.*.local

# Python virtual environment & cache
__pycache__/
*/__pycache__/
*/*/__pycache__/
*.py[cod]
